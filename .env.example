# RKT-Server environment variables
# Copy to .env and fill in. Values shown after "default:" are what the code
# falls back to when the variable is unset — you can leave those blank locally.
#
# Legend: [required] app throws / breaks without it
#         [optional] has a working default in code
#         [feature]  only needed if you use that integration

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# [optional] default: development behaviour (NODE_ENV only checked, never set by app)
NODE_ENV=development

# [optional] default: 5000
# NOTE: RKT-MainSite and RKT-Admin-store both call the API on :5001 locally,
# so use 5001 here unless you also change those clients.
PORT=5001

# ---------------------------------------------------------------------------
# Database (MongoDB — Prisma datasource provider is "mongodb")
# ---------------------------------------------------------------------------
# [required] MongoDB connection string, must include the database name.
# Local:  mongodb://localhost:27017/rktstore
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rktstore?retryWrites=true&w=majority
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# [required in production] HS256 signing secret for JWTs.
# In non-production the code falls back to "dev-only-secret-change-me".
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------------------
# Image storage — Cloudflare R2
# All five below are read via requiredEnv() in src/config/r2.ts and THROW on
# any image upload/listing if missing. Needed as soon as you touch product images.
# ---------------------------------------------------------------------------
# [required]
CLOUDFLARE_ACCOUNT_ID=
# [required]
R2_ACCESS_KEY_ID=
# [required]
R2_SECRET_ACCESS_KEY=
# [required]
R2_BUCKET_NAME=
# [required] public base URL the bucket is served from, no trailing slash
# e.g. https://pub-<hash>.r2.dev  or  https://cdn.rktstore.com
R2_PUBLIC_BASE_URL=
# [optional] default: rkt-store
R2_KEY_PREFIX=rkt-store

# ---------------------------------------------------------------------------
# Super admin bootstrap (src/bootstrap/superAdmin.ts, runs on boot)
# Leaving these blank seeds admin@store.com / admin123 — change before any
# deployment that is reachable from the internet.
# ---------------------------------------------------------------------------
# [optional] default: admin@store.com
SUPER_ADMIN_EMAIL=
# [optional] default: admin123
SUPER_ADMIN_PASSWORD=
# [optional] default: Super Admin
SUPER_ADMIN_NAME=

# ---------------------------------------------------------------------------
# Public URLs (used to build order tracking links in emails)
# ---------------------------------------------------------------------------
# [optional] e.g. http://localhost:5001
PUBLIC_API_BASE_URL=
# [optional] storefront base, e.g. http://localhost:3000
PUBLIC_MAIN_SITE_URL=

# ---------------------------------------------------------------------------
# Payments — JazzCash
# ---------------------------------------------------------------------------
# [feature] default: T00000 (non-functional placeholder)
JAZZCASH_MERCHANT_ID=
# [feature] default: xxxxx (non-functional placeholder)
JAZZCASH_PASSWORD=
# [feature] default: xxxxx (non-functional placeholder)
JAZZCASH_SALT=
# [optional] default: https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
# Swap to the production endpoint only with live credentials.
JAZZCASH_API_URL=
# [optional] where JazzCash redirects after payment; derived from PORT if unset
JAZZCASH_RETURN_URL=

# ---------------------------------------------------------------------------
# Courier selection
# ---------------------------------------------------------------------------
# [optional] "leopards" or "mnp" — default: mnp (also accepts m&p/mnpcourier/mulphilog/leopard)
# ACTIVE_COURIER_PROVIDER is a legacy alias, only read if COURIER_PROVIDER is unset.
COURIER_PROVIDER=mnp
# ACTIVE_COURIER_PROVIDER=

# --- Leopards Courier [feature] ---
LEOPARDS_API_KEY=
LEOPARDS_API_PASSWORD=
# [optional] default: https://merchantapi.leopardscourier.com/api/
LEOPARDS_API_URL=

# --- M&P / Mulphilog (MNP) [feature] ---
MNP_USERNAME=
MNP_PASSWORD=
MNP_ACCOUNT_NO=
# [optional] numeric
MNP_SUB_ACCOUNT_ID=
MNP_LOCATION_ID=
MNP_RETURN_LOCATION=
# [optional] default: Overnight
MNP_SERVICE=
# [optional] default: NO
MNP_FRAGILE=
# [optional] numeric
MNP_INSERT_TYPE=
# [optional] default: https://mnpcourier.com/mycodapi/api/
MNP_API_URL=
# [optional] default: https://tracking.mulphilog.com.pk/api/
MNP_TRACKING_URL=

# ---------------------------------------------------------------------------
# Order notification email (SMTP)
# If SMTP_HOST, SMTP_USER, SMTP_PASS or the from-address is missing, order
# emails are skipped with a console warning — the app still runs.
# ---------------------------------------------------------------------------
# [feature]
SMTP_HOST=
# [optional] default: 587
SMTP_PORT=587
# [optional] default: false — set "true" only for implicit TLS (port 465)
SMTP_SECURE=false
# [feature]
SMTP_USER=
# [feature]
SMTP_PASS=
# [feature] from-address; ORDER_EMAIL_FROM is the legacy fallback for this
SMTP_FROM_EMAIL=
# [optional] default: RKT Store
SMTP_FROM_NAME=
# [optional] falls back to the support address, then to SMTP_FROM_EMAIL
SMTP_REPLY_TO=
# [optional] legacy alias for SMTP_FROM_EMAIL
ORDER_EMAIL_FROM=
# [optional] custom tracking link template. Supported placeholders:
# {orderId} {txnRefNo} {cnNumber}
# If unset, links are built from PUBLIC_MAIN_SITE_URL, then PUBLIC_API_BASE_URL.
ORDER_TRACKING_URL_TEMPLATE=

# ---------------------------------------------------------------------------
# One-off migration script only (npm run migrate:cloudinary-to-r2)
# ---------------------------------------------------------------------------
# [optional] local directory holding the Cloudinary export to upload into R2
CLOUDINARY_EXPORT_DIR=

# ---------------------------------------------------------------------------
# Do NOT set these — injected by the hosting platform and only read for
# environment detection: VERCEL, AWS_LAMBDA_FUNCTION_NAME
# ---------------------------------------------------------------------------
